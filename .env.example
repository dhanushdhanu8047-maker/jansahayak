# JanSahayak AI – Environment Configuration
# Copy this file to .env and insert your API credentials

# Server Port & Environment
PORT=3000
NODE_ENV=development

# TinyFish API (Primary Autonomous Web Research Agent)
# Get your key at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Anthropic Claude API (Optional Reasoning & Response Generation Layer)
# If left blank, JanSahayak AI automatically uses its built-in semantic eligibility engine
ANTHROPIC_API_KEY=

# Cache & Rate Limiting Settings
CACHE_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=30
